@PACKAGE_INIT@

# Package configuration of an installed Carbon:
#
#   find_package(Carbon CONFIG REQUIRED)                      # or: COMPONENTS Extensions Reflection
#   target_link_libraries(MyApp PRIVATE Carbon::Carbon Carbon::Extensions Carbon::Reflection)
#
# Carbon_BACKENDS lists the renderer backends compiled into this package (for example "WebGPU"). Carbon links
# each backend's graphics library through its public interface, so those must be findable as well: Dawn for
# WebGPU (CMAKE_PREFIX_PATH or Dawn_DIR), unless the consuming project already defines its target.

include(CMakeFindDependencyMacro)
# carbon_import_harfbuzz_raster(): HarfBuzz's raster library from a HarfBuzz package without a target for it.
include("${CMAKE_CURRENT_LIST_DIR}/CarbonHarfBuzzRaster.cmake")

set(Carbon_BACKENDS "@CARBON_ENABLED_BACKENDS@")

if("WebGPU" IN_LIST Carbon_BACKENDS AND NOT TARGET @CARBON_DEPS_DAWN_NAME@)
    # Dawn's package links Threads::Threads without looking for it.
    find_dependency(Threads)
    find_dependency(Dawn CONFIG)
endif()
if("Vulkan" IN_LIST Carbon_BACKENDS AND NOT TARGET Vulkan::Vulkan)
    find_dependency(Vulkan)
endif()
@CARBON_PACKAGE_DEPENDENCY_CODE@
include("${CMAKE_CURRENT_LIST_DIR}/CarbonTargets.cmake")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/CarbonExtensionsTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/CarbonExtensionsTargets.cmake")
    set(Carbon_Extensions_FOUND TRUE)
else()
    set(Carbon_Extensions_FOUND FALSE)
endif()
# CarbonReflection is built on CarbonExtensions, so it is found only together with it.
if(Carbon_Extensions_FOUND AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/CarbonReflectionTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/CarbonReflectionTargets.cmake")
    set(Carbon_Reflection_FOUND TRUE)
else()
    set(Carbon_Reflection_FOUND FALSE)
endif()

# carbon_copy_dawn_runtime(<target>): copies d3dcompiler_47.dll next to an executable on Windows.
include("${CMAKE_CURRENT_LIST_DIR}/CarbonDawnRuntime.cmake")

check_required_components(Carbon)
